@@ -1,5 +1,7 @@
 import { useEffect, useRef, useState } from 'react'
 
+import { audioInputConstraints, isMissingDeviceError } from '@/lib/voice-devices'
+
 type BrowserAudioContext = typeof AudioContext
 
 export interface MicRecorderOptions {
@@ -192,9 +194,22 @@ export function useMicRecorder(copy: MicRecorderErrorCopy): {
     let stream: MediaStream
 
     try {
-      stream = await navigator.mediaDevices.getUserMedia({
-        audio: { echoCancellation: true, noiseSuppression: true }
-      })
+      const constraints: MediaTrackConstraints = { echoCancellation: true, noiseSuppression: true }
+
+      try {
+        // The configured microphone is pinned: a silent switch to the default is exactly the
+        // behaviour that setting exists to prevent. An unplugged device raises
+        // OverconstrainedError, which falls back below rather than failing the recording.
+        stream = await navigator.mediaDevices.getUserMedia({ audio: audioInputConstraints(constraints) })
+      } catch (error) {
+        if (!isMissingDeviceError(error)) {
+          throw error
+        }
+
+        console.warn('[hermes] configured microphone unavailable, using the system default', error)
+
+        stream = await navigator.mediaDevices.getUserMedia({ audio: constraints })
+      }
     } catch (error) {
       throw micError(error, copy)
     }
diff --git a/apps/desktop/src/app/settings/config-field.preview-wiring.test.tsx b/apps/desktop/src/app/settings/config-field.preview-wiring.test.tsx
new file mode 100644
index 0000000000..fd538bf64e
--- /dev/null
+++ b/apps/desktop/src/app/settings/config-field.preview-wiring.test.tsx
@@ -0,0 +1,55 @@
+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+// Keep the row shell out of the way: this test is about which rows get the audition button.
+vi.mock('./primitives', () => ({
+  ListRow: ({ action, title }: { action?: unknown; title?: string }) => (
+    <div>
+      <span>{title}</span>
+      {action as never}
+    </div>
+  )
+}))
+
+const directTtsConfig = vi.fn().mockResolvedValue(null)
+
+vi.mock('@/lib/voice-client-direct', () => ({
+  clearVoiceClientConfigCache: vi.fn(),
+  directTtsConfig: () => directTtsConfig()
+}))
+
+vi.mock('@/lib/voice-playback', () => ({ playSpeechText: vi.fn(), stopVoicePlayback: vi.fn() }))
+
+import { ConfigField } from './config-field'
+
+const renderField = (schemaKey: string) =>
+  render(
+    <ConfigField
+      onChange={() => {}}
+      schema={{ description: '', type: 'string' } as never}
+      schemaKey={schemaKey}
+      value="aura-2-thalia-en"
+    />
+  )
+
+afterEach(() => cleanup())
+
+describe('ConfigField audition wiring', () => {
+  it('puts a Preview button on the OpenRouter voice row', () => {
+    renderField('tts.openrouter.voice')
+    expect(screen.getByRole('button').textContent).toContain('Preview')
+  })
+
+  it('puts one on the speed row too, so a rate can be heard', () => {
+    renderField('tts.openrouter.speed')
+    expect(screen.getByRole('button').textContent).toContain('Preview')
+  })
+
+  it('leaves every other row alone', () => {
+    for (const key of ['tts.openrouter.model', 'tts.openai.voice', 'stt.openrouter.model', 'tts.provider']) {
+      cleanup()
+      renderField(key)
+      expect(screen.queryByRole('button')).toBeNull()
+    }
+  })
+})
