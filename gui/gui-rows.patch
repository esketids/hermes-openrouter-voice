+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { setVoicePlaybackState } from '@/store/voice-playback'
+import type { VoicePlaybackSource } from '@/store/voice-playback'
+
+const directTtsConfig = vi.fn()
+const clearVoiceClientConfigCache = vi.fn()
+const playSpeechText = vi.fn()
+const stopVoicePlayback = vi.fn()
+
+vi.mock('@/lib/voice-client-direct', () => ({
+  clearVoiceClientConfigCache: () => clearVoiceClientConfigCache(),
+  directTtsConfig: () => directTtsConfig()
+}))
+
+vi.mock('@/lib/voice-playback', () => ({
+  playSpeechText: (...args: unknown[]) => playSpeechText(...args),
+  stopVoicePlayback: () => stopVoicePlayback()
+}))
+
+import { VoicePreviewButton } from './voice-preview-button'
+
+function idle() {
+  setVoicePlaybackState({ audioElement: null, messageId: null, sequence: 0, source: null, status: 'idle' })
+}
+
+afterEach(() => {
+  cleanup()
+  idle()
+  vi.clearAllMocks()
+})
+
+describe('VoicePreviewButton', () => {
+  it('drops the cached config, then speaks the resolved voice by name', async () => {
+    directTtsConfig.mockResolvedValue({ voice: 'af_heart' })
+    playSpeechText.mockResolvedValue(true)
+
+    render(<VoicePreviewButton />)
+    fireEvent.click(screen.getByRole('button'))
+
+    await waitFor(() => expect(playSpeechText).toHaveBeenCalledTimes(1))
+
+    // the 60s config cache must not answer with the previous model/voice/speed
+    expect(clearVoiceClientConfigCache).toHaveBeenCalledTimes(1)
+    expect(clearVoiceClientConfigCache.mock.invocationCallOrder[0])
+      .toBeLessThan(directTtsConfig.mock.invocationCallOrder[0])
+
+    const [text, options] = playSpeechText.mock.calls[0] as [string, { messageId: null; source: VoicePlaybackSource }]
+    expect(text).toBe('af_heart. This is a sample of my voice.')
+    expect(options.source).toBe('read-aloud')
+    expect(options.messageId).toBeNull()
+  })
+
+  it('falls back to a generic sample when no direct config is available', async () => {
+    directTtsConfig.mockResolvedValue(null)
+    playSpeechText.mockResolvedValue(true)
+
+    render(<VoicePreviewButton />)
+    fireEvent.click(screen.getByRole('button'))
+
+    await waitFor(() => expect(playSpeechText).toHaveBeenCalledTimes(1))
+    expect(playSpeechText.mock.calls[0][0]).toBe('This is a sample of my voice.')
+  })
+
+  it('reports when nothing could play the sample', async () => {
+    directTtsConfig.mockResolvedValue(null)
+    playSpeechText.mockResolvedValue(false)
+
+    render(<VoicePreviewButton />)
+    fireEvent.click(screen.getByRole('button'))
+
+    expect(await screen.findByText(/No speech path available/)).toBeTruthy()
+  })
+
+  it('surfaces a provider error instead of failing silently', async () => {
+    directTtsConfig.mockResolvedValue({ voice: 'af_heart' })
+    playSpeechText.mockRejectedValue(new Error('OpenRouter TTS error (HTTP 400): nope'))
+
+    render(<VoicePreviewButton />)
+    fireEvent.click(screen.getByRole('button'))
+
+    expect(await screen.findByText(/HTTP 400/)).toBeTruthy()
+  })
+
+  it('offers Stop while playback is active and stops on click', () => {
+    setVoicePlaybackState({ audioElement: null, messageId: null, sequence: 1, source: 'read-aloud', status: 'speaking' })
+
+    render(<VoicePreviewButton />)
+    const button = screen.getByRole('button')
+    expect(button.textContent).toContain('Stop')
+
+    fireEvent.click(button)
+    expect(stopVoicePlayback).toHaveBeenCalledTimes(1)
+    expect(playSpeechText).not.toHaveBeenCalled()
+  })
+})
