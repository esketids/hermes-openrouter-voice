@@ -0,0 +1,73 @@
+import { useStore } from '@nanostores/react'
+import { useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { clearVoiceClientConfigCache, directTtsConfig } from '@/lib/voice-client-direct'
+import { playSpeechText, stopVoicePlayback } from '@/lib/voice-playback'
+import { $voicePlayback } from '@/store/voice-playback'
+
+/**
+ * Audition button for the OpenRouter voice rows (part of the local GUI patch).
+ *
+ * Plays a short sample using whatever is configured *right now* — model, voice and speed — through
+ * the app's own playback ladder: client-direct synthesis when the profile has client-callable TTS
+ * credentials, otherwise the gateway relay. The relay is the interesting path here: it runs the
+ * OpenRouter command provider server-side, so the measured speed handling applies (native parameter
+ * inside the model's range, local pitch-preserving stretch outside it).
+ *
+ * The voice-config cache is dropped first. It is TTL'd at 60 s, and a preview should reflect the
+ * model/voice/speed you just picked, not the values cached a minute ago.
+ */
+const SAMPLE = 'This is a sample of my voice.'
+
+export function VoicePreviewButton() {
+  const playback = useStore($voicePlayback)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+  const playing = playback.status !== 'idle'
+
+  const toggle = async () => {
+    if (playing) {
+      stopVoicePlayback()
+
+      return
+    }
+
+    setError('')
+    setBusy(true)
+
+    try {
+      clearVoiceClientConfigCache()
+      // Naming the voice in the sample makes a montage of them self-labelling; the resolved config
+      // is the only place the effective voice id is known (the field may hold an empty or a
+      // model-specific value).
+      const config = await directTtsConfig().catch(() => null)
+      const voice = config?.voice?.trim()
+      const text = voice ? `${voice}. ${SAMPLE}` : SAMPLE
+      const played = await playSpeechText(text, { messageId: null, source: 'read-aloud' })
+
+      if (!played) {
+        setError('No speech path available — check the provider credentials.')
+      }
+    } catch (err) {
+      setError(err instanceof Error ? err.message.slice(0, 120) : 'Preview failed')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className="flex flex-col items-end gap-1">
+      <Button
+        disabled={busy}
+        onClick={() => void toggle()}
+        size="sm"
+        title="Play a sample with the selected model, voice and speed"
+        variant="secondary"
+      >
+        {playing ? 'Stop' : busy ? 'Preparing…' : 'Preview'}
+      </Button>
+      {error ? <span className="max-w-56 text-right text-xs text-muted-foreground">{error}</span> : null}
+    </div>
+  )
+}
